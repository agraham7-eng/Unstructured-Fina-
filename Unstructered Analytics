```{python}
import pandas as pd
import requests

url = "https://sports.yahoo.com/ncaab/teams/duke/stats/"

response = requests.get(url, verify=False)

tables = pd.read_html(response.text)

print(len(tables))
df = tables[0]
print(df.head())
```
```{python}
import numpy as np
import matplotlib.pyplot as plt

plt.figure()

plt.scatter(df["Min"], df["Pts"])

for i, name in enumerate(df["Player"]):
    plt.annotate(name, (df["Min"][i], df["Pts"][i]), fontsize=8)

z = np.polyfit(df["Min"], df["Pts"], 1)
p = np.poly1d(z)
plt.plot(df["Min"], p(df["Min"]))

plt.xlabel("Minutes Per Game")
plt.ylabel("Points Per Game")
plt.title("Scoring vs Playing Time")
plt.show()
```
```{python}
plt.figure()

